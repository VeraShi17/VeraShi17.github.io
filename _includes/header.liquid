<header>
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Primary navigation"
  >
    <div class="container">
      <a class="navbar-brand" href="{{ '/' | relative_url }}" aria-label="Jiarui Shi — About">
        <span aria-hidden="true">JS</span>
      </a>

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item {% if page.url == '/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.url == '/' %}
                aria-current="page"
              {% endif %}
              >About</a
            >
          </li>
          <li class="nav-item {% if page.url == '/projects/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/projects/' | relative_url }}"
              {% if page.url == '/projects/' %}
                aria-current="page"
              {% endif %}
              >Projects</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ site.data.socials.cv_pdf | prepend: '/' | relative_url }}" target="_blank" rel="noopener noreferrer"
              >Resume <span class="sr-only">(PDF, opens in a new tab)</span></a
            >
          </li>
          {% if site.data.socials.github_username %}
            <li class="nav-item nav-icon-item">
              <a
                class="nav-link"
                href="https://github.com/{{ site.data.socials.github_username | escape }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub profile (opens in a new tab)"
                ><i class="fa-brands fa-github" aria-hidden="true"></i><span class="nav-icon-label"> GitHub</span></a
              >
            </li>
          {% endif %}
          {% if site.data.socials.linkedin_username %}
            <li class="nav-item nav-icon-item">
              <a
                class="nav-link"
                href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username | escape }}/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn profile (opens in a new tab)"
                ><i class="fa-brands fa-linkedin" aria-hidden="true"></i><span class="nav-icon-label"> LinkedIn</span></a
              >
            </li>
          {% endif %}
          {% if site.data.socials.email %}
            <li class="nav-item nav-icon-item">
              <a class="nav-link" href="mailto:{{ site.data.socials.email | escape }}" aria-label="Email Jiarui Shi"
                ><i class="fa-regular fa-envelope" aria-hidden="true"></i><span class="nav-icon-label"> Email</span></a
              >
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="nav-item toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark" aria-hidden="true"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
